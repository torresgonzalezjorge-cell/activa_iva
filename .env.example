# Railway: pegue la URL que entrega el plugin de PostgreSQL.
# En local deje esta línea comentada. Si se define, tiene prioridad
# y activa SSL automático cuando el host no es localhost.
# DATABASE_URL=postgres://usuario:clave@host:5432/railway

# Entorno local. Se usan cuando DATABASE_URL no está definida.
PGHOST=localhost
PGPORT=5432
PGDATABASE=activa_iva
PGUSER=postgres
PGPASSWORD=clave

# Puerto local. En Railway el servicio usa la variable PORT que inyecta la plataforma.
PORT=3002
